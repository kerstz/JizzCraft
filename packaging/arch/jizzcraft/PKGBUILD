# Maintainer: JizzCraft contributors <noreply@example.invalid>
#
# Release build. After each tag: `updpkgsums`, then `makepkg --printsrcinfo > .SRCINFO`.
# jizzcraft is the Offline edition (no network code at all).
# The Online edition lives in ../jizzcraft-online.

pkgbase=jizzcraft
pkgname=(jizzcraft)
pkgver=0.2.0
pkgrel=1
pkgdesc='Private, offline media viewer and library (images and videos)'
arch=(x86_64 aarch64)
url='https://github.com/kerstz/JizzCraft'
license=('MIT OR Apache-2.0')
makedepends=(cargo pkgconf perl make gcc gstreamer gst-plugins-base-libs)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('ebf9f3dc7a314284bc11c20e1917e880df1c3c26be854308cb89a2c2f7e5b9e9')
options=(!lto)

prepare() {
  cd "JizzCraft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "JizzCraft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo xtask dist --destdir "$srcdir/stage" --prefix /usr
}

check() {
  cd "JizzCraft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p jizzcraft-core
}

_common_depends=(gcc-libs glibc gstreamer gst-plugins-base-libs gst-plugins-base
  gst-plugins-good gst-libav vulkan-icd-loader libxkbcommon wayland libx11
  libxcursor libxrandr libxi)
_common_optdepends=('gst-plugins-bad: AV1 decoding'
  'gst-plugin-va: hardware decoding'
  'xdg-desktop-portal: file chooser'
  'vulkan-driver: GPU rendering')

package_jizzcraft() {
  depends=("${_common_depends[@]}")
  optdepends=("${_common_optdepends[@]}")
  cp -a "$srcdir/stage/." "$pkgdir/"
  install -Dm644 /dev/null "$pkgdir/usr/share/doc/$pkgname/.keep" && rm "$pkgdir/usr/share/doc/$pkgname/.keep"
}
