// Windows resources: icon, manifest, version information.
#include <winres.h>

1 ICON "../../../assets/icons/jizzcraft.ico"
1 RT_MANIFEST "jizzcraft.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            // Task Manager shows FileDescription: kept neutral on purpose.
            VALUE "FileDescription", "Media Viewer"
            VALUE "ProductName", "JizzCraft"
            VALUE "ProductVersion", "0.1.0"
            VALUE "FileVersion", "0.1.0"
            VALUE "OriginalFilename", "jizzcraft.exe"
            VALUE "LegalCopyright", "JizzCraft contributors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
