<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.jizzcraft.JizzCraft</id>
  <name>JizzCraft</name>
  <summary>Private, offline media viewer and library manager</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <developer id="org.jizzcraft"><name>JizzCraft contributors</name></developer>
  <url type="homepage">https://github.com/kerstz/JizzCraft</url>
  <url type="bugtracker">https://github.com/kerstz/JizzCraft/issues</url>
  <description>
    <p>
      JizzCraft is a private, local-first viewer and library manager for
      images and videos, written in Rust. Your files are indexed in place and
      never modified. No accounts, no telemetry, and no network connections in
      the default build.
    </p>
    <p>
      Independent project, not affiliated with any other product.
    </p>
  </description>
  <launchable type="desktop-id">org.jizzcraft.JizzCraft.desktop</launchable>
  <provides><binary>jizzcraft</binary><binary>jizzcraft-cli</binary></provides>
  <requires><display_length compare="ge">768</display_length></requires>
  <supports><control>keyboard</control><control>pointing</control></supports>
  <branding>
    <color type="primary" scheme_preference="light">#ffd9c2</color>
    <color type="primary" scheme_preference="dark">#2a1d17</color>
  </branding>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>
  <content_rating type="oars-1.1">
    <content_attribute id="sex-nudity">intense</content_attribute>
  </content_rating>
  <releases>
    <release version="0.1.0" date="2026-10-13"/>
  </releases>
</component>
