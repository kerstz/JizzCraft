[Desktop Entry]
Type=Application
Name=JizzCraft (magnet links)
GenericName=Media Viewer
Comment=Play magnet links. Needs the network build.
Exec=jizzcraft %u
Icon=io.github.kerstz.JizzCraft
Terminal=false
NoDisplay=true
